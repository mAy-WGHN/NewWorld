<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Helper library for tests, not a test project itself. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.ServiceBus" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Verify.Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Emulator entities for tests; copied to every referencing test project. -->
    <None Include="ServiceBusEmulatorConfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared.Authorization\Shared.Authorization.csproj" />
    <ProjectReference Include="..\Shared.Messaging\Shared.Messaging.csproj" />
  </ItemGroup>
</Project>
