# Kopieren nach .env und mit echten Werten füllen. .env wird beim Start automatisch geladen (Program.cs) und überschreibt
# nichts, was schon als echte Umgebungsvariable gesetzt ist (z. B. in Prod). Nie committen.

# Azure-AD-App-Registrierung für Business Central (OAuth2 Client-Credentials)
BusinessCentral__ClientId=
BusinessCentral__ClientSecret=
BusinessCentral__Scope=
BusinessCentral__TenantId=
BusinessCentral__Environment=
BusinessCentral__CompanyName=

# Wer diesen Dienst aufrufen darf: je Aufrufer ein eigener API-Schlüssel (mind. 32 zufällige Zeichen). Der Aufrufer sendet ihn im Header X-Api-Key.
# Erzeugen (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Gateway__ApiKeys__Identity=
Gateway__ApiKeys__Portal=
Gateway__ApiKeys__Hr=

# Wie lange die Filialliste zwischengespeichert wird (Sekunden, 0 = nie)
Gateway__StoresCacheSeconds=
