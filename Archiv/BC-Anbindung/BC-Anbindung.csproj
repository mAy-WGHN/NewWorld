<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BC_Anbindung</RootNamespace>
  </PropertyGroup>

  <!-- Das Testprojekt liegt im Unterordner und darf nicht in den Haupt-Build einkompiliert werden. -->
  <ItemGroup>
    <Compile Remove="BC-Anbindung.Tests/**" />
    <Content Remove="BC-Anbindung.Tests/**" />
    <EmbeddedResource Remove="BC-Anbindung.Tests/**" />
    <None Remove="BC-Anbindung.Tests/**" />
  </ItemGroup>

</Project>
