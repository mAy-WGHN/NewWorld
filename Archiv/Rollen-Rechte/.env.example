# Kopieren nach .env und mit echten Werten füllen. .env wird beim Start automatisch geladen (Program.cs) und überschreibt
# nichts, was schon als echte Umgebungsvariable gesetzt ist (z. B. in Prod). Nie committen.

# Datenbank (lokal: make db-up, Port 5433; Prod: Azure-Wert)
ConnectionStrings__Default=

# JWT: RSA-Schlüsselpaar des bisherigen Symfony-Backends übernehmen, dann bleiben ausgestellte Tokens gültig.
# PEM-Inhalt (Zeilenumbrüche als \n) ODER Dateipfad; Passphrase nur für verschlüsselte Private-Keys (PKCS#8).
Jwt__PrivateKey=
Jwt__PrivateKeyPath=
Jwt__PublicKey=
Jwt__PublicKeyPath=
Jwt__Passphrase=
# Nur Fallback ohne RSA (HS256, mind. 32 Zeichen): alle müssen sich dann einmal neu einloggen.
Jwt__Key=

# CORS: Regex der erlaubten Origins und/oder Liste
Cors__AllowedOriginPattern=
Cors__AllowedOrigins__0=

# Optional: nur diesen Proxy-IPs wird X-Forwarded-For geglaubt (sonst jedem Proxy)
ForwardedHeaders__KnownProxies__0=

# --- BC-Anbindung (der einzige Weg zu Business Central) -----------------------------------------------------------
# Adresse des Dienstes "BC-Anbindung" und der Schlüssel, den er für diesen Aufrufer vergeben hat (dort: Gateway__ApiKeys__Identity).
BcGateway__BaseUrl=
BcGateway__ApiKey=

# Schlüssel für das verschlüsselt gespeicherte BC-PIN (Base64, 32 Bytes). Ohne ihn ist die BC-Anmeldung aus.
# Erzeugen (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Wichtig: sichern und nie wechseln, sonst lassen sich gespeicherte PINs nicht mehr entschlüsseln.
Auth__PinEncryptionKey=
# false: BC-Mitarbeiter ohne User werden nicht automatisch angelegt (Default true; neue User haben ohne Rolle keine Rechte)
Auth__BcAutoCreateUsers=
# false: kein Filialabgleich beim Start (Default true; manuell: make sync-stores)
Locations__SyncOnStartup=

# --- Anwendungen, die ihren Rechtekatalog anmelden dürfen ----------------------------------------------------------------
# Je Anwendung ein eigener Schlüssel (mind. 32 zufällige Zeichen); sie senden ihn im Header X-Api-Key an PUT /api/apps/{appKey}/catalog.
Apps__Keys__portal=
Apps__Keys__hr=
Apps__Keys__notifications=

# Optional: legt beim Start einen Administrator an, falls es ihn noch nicht gibt (Alternative: make create-user NAME=...)
Seed__AdminUsername=
Seed__AdminPassword=
