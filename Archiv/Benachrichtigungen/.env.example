# Kopieren nach .env und mit echten Werten füllen. .env wird beim Start automatisch geladen (Program.cs) und überschreibt
# nichts, was schon als echte Umgebungsvariable gesetzt ist (z. B. in Prod). Nie committen.

# Datenbank (lokal: make db-up, Port 5434; Prod: Azure-Wert)
ConnectionStrings__Default=

# JWT, das "Rollen-Rechte" ausstellt: hier nur zum Prüfen. Dasselbe Schlüsselpaar bzw. denselben Fallback-Schlüssel wie dort eintragen.
# RSA: Jwt__PublicKey / Jwt__PublicKeyPath (PEM-Inhalt mit \n oder Dateipfad).
Jwt__PublicKey=
Jwt__PublicKeyPath=
# Nur Fallback ohne RSA (HS256, mind. 32 Zeichen), gleicher Wert wie bei Rollen-Rechte.
Jwt__Key=

# Web Push: das Schlüsselpaar MUSS unverändert bleiben, sonst sind alle Browser-Abos ungültig (Wert aus dem bisherigen Portal übernehmen)
Vapid__PublicKey=
Vapid__PrivateKey=
Vapid__Subject=

# Adresse der Oberfläche (für den Link in der Benachrichtigung)
Frontend__BaseUrl=

# CORS: Regex der erlaubten Origins und/oder Liste (die Oberfläche ruft die Push-Endpunkte direkt auf)
Cors__AllowedOriginPattern=
Cors__AllowedOrigins__0=

# Optional: nur diesen Proxy-IPs wird X-Forwarded-For geglaubt (sonst jedem Proxy)
ForwardedHeaders__KnownProxies__0=

# --- Rollen-Rechte (beantwortet "Wer darf das sehen?") ------------------------------------------------------------------
# Adresse des Dienstes, Name dieser Anwendung dort und der Schlüssel, den Rollen-Rechte dafür vergeben hat (dort: Apps__Keys__notifications).
Access__BaseUrl=
Access__AppKey=notifications
Access__ApiKey=

# --- Absender von Ereignissen --------------------------------------------------------------------------------------------
# Je Absender ein eigener Schlüssel (mind. 32 zufällige Zeichen); der Absender sendet ihn im Header X-Api-Key an POST /api/events.
# Erzeugen (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Sources__Keys__portal=
Sources__Keys__hr=
