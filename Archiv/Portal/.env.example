# Kopieren nach .env und mit echten Werten füllen. .env wird beim Start automatisch geladen (Program.cs) und überschreibt
# nichts, was schon als echte Umgebungsvariable gesetzt ist (z. B. in Prod). Nie committen.

# Datenbank (Prod: Azure-Wert, nicht ins Repo)
ConnectionStrings__Default=

# JWT: Das Token stellt "Rollen-Rechte" aus, das Portal prüft nur die Signatur. Den öffentlichen Schlüssel von dort eintragen
# (PEM-Inhalt mit \n oder Dateipfad); der private Schlüssel gehört nur Rollen-Rechte.
Jwt__PublicKey=
Jwt__PublicKeyPath=
# Nur Fallback ohne RSA (HS256, mind. 32 Zeichen), gleicher Wert wie bei Rollen-Rechte.
Jwt__Key=

# --- Rollen-Rechte (Rechte, Reichweite, Filialen) ---------------------------------------------------------------------
# Adresse des Dienstes, Name dieser Anwendung dort und der Schlüssel, den Rollen-Rechte dafür vergeben hat (dort: Apps__Keys__portal).
Access__BaseUrl=
Access__AppKey=portal
Access__ApiKey=
# Sekunden, die die Rechte eines Tokens zwischengespeichert werden (ein Entzug wirkt spätestens danach)
Access__CacheSeconds=

# --- Benachrichtigungen (neue Meldungen) ------------------------------------------------------------------------------------
# Adresse des Dienstes und der Schlüssel, den er für das Portal vergeben hat (dort: Sources__Keys__portal). Ohne beide keine Benachrichtigung.
Notifications__BaseUrl=
Notifications__ApiKey=

# CORS: Regex der erlaubten Origins (im Symfony-Original CORS_ALLOW_ORIGIN) und/oder Liste
Cors__AllowedOriginPattern=
Cors__AllowedOrigins__0=

# Uploads der FAQ-Bilder (Azure App Service: unter /home, z. B. /home/uploads/faq)
Uploads__FaqPath=

# Optional: nur diesen Proxy-IPs wird X-Forwarded-For geglaubt (sonst jedem Proxy)
ForwardedHeaders__KnownProxies__0=
